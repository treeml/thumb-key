<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ equivalent of allowBackup="false": nothing leaves the device,
  either to cloud backup or to a device-to-device transfer. Patient data and
  clinical photos are not something to hand to a restore flow the user did not
  ask for; the app's own Export backup is the way to move a shift's data.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
